# ==============================================================================
# NORTE BOUND — Backend Environment Template (Supabase PostgreSQL)
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

NODE_ENV=development
PORT=5000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
DATABASE_URL=postgresql://user.project_ref:password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_PORT=5432
DB_SSL=true

JWT_SECRET=super_secret_jwt_key_change_in_production
ADMIN_INVITE_CODE=NORTE-CURATOR-2026
GEMINI_API_KEY=your_gemini_api_key_here
